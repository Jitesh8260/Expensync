# Expensync Server Environment Variables
# Copy this file to '.env' and fill in the values.

# Server listening port
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/expensync

# JWT access token signature secret (generate a secure random string)
JWT_SECRET=your_jwt_access_secret_here

# JWT refresh token signature secret (generate a secure random string)
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_here

# Python Flask ML Service base URL
ML_SERVICE_URL=http://localhost:5050

# CORS Allowed Origin (set to client URL in production)
ALLOWED_ORIGIN=http://localhost:5173
